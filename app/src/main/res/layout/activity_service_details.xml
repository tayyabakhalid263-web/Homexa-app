<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingTop="@dimen/space_xl"
            android:paddingEnd="@dimen/screen_padding"
            android:paddingBottom="@dimen/space_lg">

            <TextView
                android:id="@+id/buttonBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_sm"
                android:text="@string/back"
                android:textAppearance="@style/TextAppearance.Homexa.Link" />

            <!-- Large provider image -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/hero_image_height"
                android:layout_marginTop="@dimen/space_md"
                android:background="@drawable/bg_promo_banner">

                <ImageView
                    android:id="@+id/imageProvider"
                    android:layout_width="@dimen/avatar_large"
                    android:layout_height="@dimen/avatar_large"
                    android:layout_gravity="center"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_avatar_1" />
            </FrameLayout>

            <TextView
                android:id="@+id/textProviderName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:text="@string/provider_ahmed_name"
                android:textAppearance="@style/TextAppearance.Homexa.Title" />

            <TextView
                android:id="@+id/textServiceType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/category_electrician"
                android:textAppearance="@style/TextAppearance.Homexa.Body"
                android:textColor="@color/accent"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:gravity="center"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/card_elevation"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/rating"
                        android:textAppearance="@style/TextAppearance.Homexa.Caption" />

                    <include
                        android:id="@+id/ratingView"
                        layout="@layout/view_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs" />
                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_md"
                    android:layout_height="1dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:elevation="@dimen/card_elevation"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="@dimen/space_md">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/experience"
                        android:textAppearance="@style/TextAppearance.Homexa.Caption" />

                    <TextView
                        android:id="@+id/textExperience"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/provider_ahmed_exp"
                        android:textAppearance="@style/TextAppearance.Homexa.Body"
                        android:textColor="@color/text_primary"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/description"
                android:textAppearance="@style/TextAppearance.Homexa.Heading" />

            <TextView
                android:id="@+id/textDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:lineSpacingExtra="4dp"
                android:text="@string/provider_ahmed_desc"
                android:textAppearance="@style/TextAppearance.Homexa.Body" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/starting_from"
                android:textAppearance="@style/TextAppearance.Homexa.Heading" />

            <TextView
                android:id="@+id/textStartingPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/provider_ahmed_price"
                android:textAppearance="@style/TextAppearance.Homexa.Title"
                android:textColor="@color/primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/available_time"
                android:textAppearance="@style/TextAppearance.Homexa.Heading" />

            <TextView
                android:id="@+id/textAvailableTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:background="@drawable/bg_search_bar"
                android:padding="@dimen/space_md"
                android:text="@string/provider_ahmed_availability"
                android:textAppearance="@style/TextAppearance.Homexa.Body"
                android:textColor="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/customer_reviews"
                android:textAppearance="@style/TextAppearance.Homexa.Heading" />

            <include
                layout="@layout/item_review_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        android:elevation="8dp"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <include
            android:id="@+id/buttonBookNow"
            layout="@layout/view_primary_button" />
    </LinearLayout>

</LinearLayout>

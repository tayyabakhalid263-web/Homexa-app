<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="@dimen/space_xl"
        android:paddingEnd="@dimen/screen_padding">

        <TextView
            android:id="@+id/buttonBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="@dimen/space_sm"
            android:text="@string/back"
            android:textAppearance="@style/TextAppearance.Homexa.Link"
            android:visibility="gone" />

        <TextView
            android:id="@+id/textServicesTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_services"
            android:textAppearance="@style/TextAppearance.Homexa.Title" />

        <TextView
            android:id="@+id/textServicesSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/services_subtitle"
            android:textAppearance="@style/TextAppearance.Homexa.Body" />

        <include
            android:id="@+id/searchBar"
            layout="@layout/view_search_bar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="@dimen/space_lg" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerProviders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_lg"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_md" />

        <TextView
            android:id="@+id/textNoProviders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/no_providers"
            android:textAppearance="@style/TextAppearance.Homexa.Body"
            android:visibility="gone" />

    </LinearLayout>

    <include layout="@layout/view_bottom_nav" />

</LinearLayout>
